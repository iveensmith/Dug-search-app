{
  "name": "mediquest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:start": "pgsql\\bin\\pg_ctl -D pgdata -l pgdata\\server.log -w start",
    "db:stop": "pgsql\\bin\\pg_ctl -D pgdata stop",
    "db:status": "pgsql\\bin\\pg_ctl -D pgdata status",
    "db:seed": "tsx prisma/seed.ts",
    "verify:phase1": "tsx scripts/verify-phase1.ts",
    "postinstall": "prisma generate",
    "vercel-build": "prisma migrate deploy && next build",
    "audit:passwords": "tsx scripts/audit-password-hashes.ts",
    "classify:dispensing": "tsx scripts/classify-dispensing.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.9.1",
    "@supabase/supabase-js": "^2.110.6",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jose": "^6.2.3",
    "leaflet": "^1.9.4",
    "next": "^16.3.2",
    "papaparse": "^5.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@csstools/postcss-cascade-layers": "^6.0.0",
    "@csstools/postcss-color-mix-function": "^4.0.8",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "postcss-custom-properties": "^14.0.6",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "browserslist": [
    "iOS >= 12",
    "Safari >= 12",
    "Chrome >= 64",
    "Firefox >= 63",
    "Edge >= 79",
    "not dead"
  ]
}
