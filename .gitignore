# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Secrets -----------------------------------------------------------
# Anything below is either a credential or a common place to keep one.
# Nothing here has ever been committed and nothing should be; if you need
# to share a value, put a placeholder in .env.example instead.
#
# The negation must stay LAST in this file: gitignore takes the final
# matching pattern, so a stray `.env*` further down re-ignores the one
# file that is meant to be tracked. That had happened.
.env*
*.pem
*.key
*.p12
*.pfx
*.keystore
.npmrc
.netrc
.pgpass
id_rsa*
id_ed25519*
credentials.json
service-account*.json
secrets.json
secrets.ya?ml
!.env.example

# local Claude Code permission settings
.claude/settings.local.json

# local portable PostgreSQL (runtime + data — never commit)
/pgsql/
/pgdata/

# prescription image uploads (local disk storage)
/storage/

# generated Prisma client
/src/generated/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
