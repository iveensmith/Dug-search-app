// MediQuest — nationwide (Nigeria) MVP schema
// Geospatial note: plain lat/lng Float columns + Haversine in raw SQL. Search
// is scoped by state (see NigerianState) rather than a fixed-radius bounding
// box, so this stays accurate at country scale without needing PostGIS.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  PHARMACY_OWNER
  PHARMACIST
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DrugForm {
  TABLET
  CAPSULE
  SYRUP
  SUSPENSION
  INJECTION
  CREAM
  OINTMENT
  GEL
  DROPS
  INHALER
  SUPPOSITORY
  OTHER
}

// A reservation is a request to hold stock, never a purchase or a
// guarantee — nothing is paid and the pharmacy is free to decline. The
// wording everywhere the patient sees it has to keep saying so.
enum ReservationStatus {
  PENDING // patient asked; the pharmacy hasn't answered yet
  READY // pharmacy has set it aside
  COLLECTED // patient picked it up
  CANCELLED // patient changed their mind
  DECLINED // pharmacy can't hold it after all
}

/// How much of a drug a pharmacy has, in the only terms a patient can act
/// on. Not a count: "12" means something different for boxes, strips and
/// single tablets, and the unit is never recorded — so a number cannot be
/// banded reliably and the pharmacy says which band it is.
///
/// Null is a real answer and the default: it means "in stock, amount not
/// said", which is exactly what every listing meant before this existed.
enum StockLevel {
  PLENTY // a full course, or several
  LOW // enough for one person, probably
  LAST_FEW // call before travelling
}

enum PrescriptionStatus {
  PENDING
  CLAIMED
  ANSWERED
  CLOSED
}

enum NigerianState {
  ABIA
  ADAMAWA
  AKWA_IBOM
  ANAMBRA
  BAUCHI
  BAYELSA
  BENUE
  BORNO
  CROSS_RIVER
  DELTA
  EBONYI
  EDO
  EKITI
  ENUGU
  FCT_ABUJA
  GOMBE
  IMO
  JIGAWA
  KADUNA
  KANO
  KATSINA
  KEBBI
  KOGI
  KWARA
  LAGOS
  NASARAWA
  NIGER
  OGUN
  ONDO
  OSUN
  OYO
  PLATEAU
  RIVERS
  SOKOTO
  TARABA
  YOBE
  ZAMFARA
}

model User {
  id                     String         @id @default(cuid())
  // Not globally unique — the same email/phone can have one account per
  // role (e.g. a patient account and a separate pharmacy-owner account),
  // enforced instead by @@unique([email, role]) / @@unique([phone, role])
  // below. Login disambiguates by role (the Patient/Pharmacy portal tab).
  email                  String?
  phone                  String?
  passwordHash           String
  displayName            String?
  role                   Role           @default(PATIENT)
  state                  NigerianState? // patient's home state — pre-fills the search state picker
  passwordResetTokenHash String?        @unique // SHA-256 of the emailed token — raw token never stored
  passwordResetExpiresAt DateTime?
  createdAt              DateTime       @default(now())

  pharmacy       Pharmacy? // set when role = PHARMACY_OWNER
  uploads        PrescriptionUpload[]  @relation("PatientUploads")
  claimedUploads PrescriptionUpload[]  @relation("PharmacistClaims")
  sentMessages   PrescriptionMessage[]
  searchLogs     SearchLog[]
  ratings        PharmacyRating[]
  reservations   Reservation[]

  @@unique([email, role])
  @@unique([phone, role])
}

model Drug {
  id          String   @id @default(cuid())
  genericName String
  brandNames  String[] // Postgres text[] — fine for a curated list; promote to a table if it grows
  strength    String // e.g. "500 mg"
  form        DrugForm
  category    String? // therapeutic class, from src/lib/drugCategories.ts — always set by a person, never inferred
  packSize    String? // pack/container size for non-tablet forms, e.g. "30 g tube", "100 ml bottle"
  createdAt   DateTime @default(now())

  inventory      PharmacyInventory[]
  searchLogs     SearchLog[]
  notifyRequests StockNotifyRequest[]
  reservations   Reservation[]

  // Autocomplete matches genericName and brandNames with a leading-wildcard
  // ILIKE, which no btree can serve. Two trigram GIN indexes cover it,
  // declared in migration 20260807090000_search_and_fk_indexes rather than
  // here: one is on a function of brandNames, which this schema language
  // has no way to express.
  @@unique([genericName, strength, form])
  @@index([category])
}

model Pharmacy {
  id                 String             @id @default(cuid())
  name               String
  address            String
  state              NigerianState      @default(AKWA_IBOM) // default backfills pre-existing Uyo-only rows; every registration sets it explicitly
  lga                String? // Local Government Area within the state — validated against src/lib/lgas.ts; nullable for rows registered before LGAs existed
  latitude           Float
  longitude          Float
  phone              String
  pcnLicenseNumber   String             @unique
  verificationStatus VerificationStatus @default(PENDING)
  ownerUserId        String             @unique
  // Self-reported hours — same every day, no per-day overrides, no
  // verification. "HH:mm" 24h strings, compared against Africa/Lagos time
  // (Nigeria is UTC+1 year-round, no DST — see src/lib/hours.ts).
  open24h            Boolean            @default(false)
  opensAt            String?
  closesAt           String?
  createdAt          DateTime           @default(now())

  owner        User                @relation(fields: [ownerUserId], references: [id])
  inventory    PharmacyInventory[]
  ratings      PharmacyRating[]
  reservations Reservation[]

  @@index([verificationStatus])
  @@index([state])
  @@index([state, lga])
  @@index([latitude, longitude])
}

model PharmacyInventory {
  id         String    @id @default(cuid())
  pharmacyId String
  drugId     String
  inStock    Boolean   @default(true)
  stockLevel StockLevel? // null = in stock, amount not stated
  quantity   Int? // the pharmacy's own count, for their reference only
  brand      String? // which brand this pharmacy actually stocks, if they know
  expiryDate DateTime? // optional — pharmacy's own stock-rotation note
  updatedAt  DateTime  @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  drug     Drug     @relation(fields: [drugId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, drugId])
  @@index([drugId, inStock]) // drives the core "who has drug X in stock" query
}

// A patient's rating of one pharmacy, across the four things patients told
// us they judge a pharmacy on. One row per (pharmacy, user) — rating again
// updates the existing row rather than stacking, so a single unhappy visit
// can't be voted repeatedly. Owners cannot rate their own pharmacy.
model PharmacyRating {
  id             String    @id @default(cuid())
  pharmacyId     String
  userId         String
  availability   Int // did they have the drugs? 1-5
  service        Int // speed and helpfulness of staff
  pricing        Int // fair pricing
  honesty        Int // genuine drugs, honest advice
  comment        String? // optional free text, shown to other patients
  ownerReply     String? // the pharmacy's public response to that comment
  ownerRepliedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, userId])
  @@index([pharmacyId, createdAt])
  @@index([userId]) // FK — cascade on user delete would otherwise scan the table
}

model SearchLog {
  id         String         @id @default(cuid())
  drugId     String? // null when free-text query matched no drug
  userId     String? // set when the searcher was logged in — powers per-user search history
  queryText  String
  state      NigerianState? // nullable: not recorded before this field existed
  lga        String? // LGA the search was scoped to — null for rows logged before LGA scoping
  latitude   Float?
  longitude  Float?
  hadResults Boolean
  createdAt  DateTime       @default(now())

  drug Drug? @relation(fields: [drugId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([hadResults, createdAt]) // coverage-gap analytics
  @@index([userId, createdAt]) // per-user search history
  @@index([state, createdAt]) // state-level demand analytics
  @@index([state, lga, createdAt]) // a pharmacy's own LGA demand feed
  @@index([drugId]) // FK — SetNull on drug delete would otherwise scan the table
}

// A patient asking a pharmacy to hold a drug until they get there, and the
// record of whether they actually collected it.
//
// There is deliberately no price, no payment and no expiry job: the app
// doesn't handle money, and a reservation silently expiring would be worse
// than one that sits there until somebody closes it. Staleness is shown in
// the UI from createdAt instead.
//
// No unique constraint on (user, pharmacy, drug) — the same patient can
// reserve the same drug at the same pharmacy again months later. Reserving
// twice while one is still open is prevented in the API instead, which
// returns the open reservation rather than making a second one.
model Reservation {
  id           String            @id @default(cuid())
  userId       String
  pharmacyId   String
  drugId       String
  quantity     Int? // how many packs/units, if the patient said
  note         String? // e.g. "coming after 5pm" — free text, patient's words
  contactPhone String? // so the counter can call back; copied from the account or typed in
  status       ReservationStatus @default(PENDING)
  collectedAt  DateTime? // set when it reaches COLLECTED, whoever marked it
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  drug     Drug     @relation(fields: [drugId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt]) // the patient's own list
  @@index([pharmacyId, status, createdAt]) // the counter's queue
  @@index([drugId]) // FK — cascade on drug delete would otherwise scan the table
}

// A patient's "email me when this is in stock" request against a
// zero-result search. Anonymous (no login required) — just drug + state +
// email. Triggered from src/app/api/inventory/route.ts and [id]/route.ts
// whenever a matching pharmacy in that state marks the drug in stock.
model StockNotifyRequest {
  id         String        @id @default(cuid())
  drugId     String
  state      NigerianState
  email      String
  createdAt  DateTime      @default(now())
  notifiedAt DateTime? // null = still waiting; set once we've emailed them

  drug Drug @relation(fields: [drugId], references: [id], onDelete: Cascade)

  @@unique([drugId, state, email])
  @@index([drugId, state, notifiedAt])
}

model PrescriptionUpload {
  id               String             @id @default(cuid())
  patientUserId    String
  pharmacistUserId String? // set when a pharmacist claims the upload
  imageKey         String // storage-adapter key, NOT a public URL
  patientNote      String? // optional "what confuses me" note
  status           PrescriptionStatus @default(PENDING)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  patient    User                  @relation("PatientUploads", fields: [patientUserId], references: [id])
  pharmacist User?                 @relation("PharmacistClaims", fields: [pharmacistUserId], references: [id])
  messages   PrescriptionMessage[]

  @@index([status, createdAt]) // pharmacist claim queue
  @@index([patientUserId])
  @@index([pharmacistUserId])
}

model PrescriptionMessage {
  id                   String    @id @default(cuid())
  prescriptionUploadId String
  senderUserId         String
  messageText          String
  createdAt            DateTime  @default(now())
  readAt               DateTime? // null = unread; powers the in-app notification badge

  upload PrescriptionUpload @relation(fields: [prescriptionUploadId], references: [id], onDelete: Cascade)
  sender User               @relation(fields: [senderUserId], references: [id])

  @@index([prescriptionUploadId, createdAt])
  @@index([senderUserId]) // FK — restrict check on user delete would otherwise scan the table
}

/// Counters behind the sign-in throttle (lib/loginThrottle).
///
/// Postgres rather than an in-process Map because the app runs on
/// serverless functions: a per-instance counter resets whenever the
/// platform starts a new one, so an attacker gets a fresh allowance for
/// free and a "locked" account stays open on every other instance. This
/// is the only state all instances already share.
///
/// `key` is either `ip:<address>` or `account:<sha256 of identifier and
/// portal>` — never a raw email, so the table cannot be read as a list of
/// who has an account here.
model AuthThrottle {
  key           String    @id
  count         Int       @default(0) // failures in the current window
  windowStart   DateTime  @default(now())
  lockedUntil   DateTime? // set once the failure threshold is crossed
  nextAttemptAt DateTime? // progressive delay between attempts
  notifiedAt    DateTime? // lockout email already sent for this lock
  updatedAt     DateTime  @updatedAt

  @@index([updatedAt]) // for pruning rows that have gone quiet
}
